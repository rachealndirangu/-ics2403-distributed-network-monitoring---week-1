digraph "resource-allocation graph" {
  rankdir=LR;
  node [fontname=Helvetica];
  "P0" [shape=circle];
  "P1" [shape=circle];
  "P2" [shape=circle];
  "P3" [shape=circle];
  "R0" [shape=box];
  "R1" [shape=box];
  "R2" [shape=box];
  "R3" [shape=box];
  "P1" -> "R2" [label="request", style=dashed];
  "P0" -> "R0" [label="request", style=dashed];
  "P2" -> "R3" [label="request", style=dashed];
  "R2" -> "P2" [label="held by"];
  "R0" -> "P3" [label="held by"];
  "R1" -> "P1" [label="held by"];
  "R3" -> "P3" [label="held by"];
}